{
  "entities": {
    "Exercicio": {
      "title": "Exercício",
      "description": "Catálogo de exercícios disponíveis.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "grupoMuscular": { "type": "string" }
      },
      "required": ["nome", "grupoMuscular"]
    },
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados biométricos e objetivos do usuário.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "pesoAtualKg": { "type": "number" },
        "alturaCm": { "type": "number" },
        "objetivo": { "type": "string", "enum": ["cutting", "bulking", "manutenção"] },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "pesoAtualKg", "alturaCm", "objetivo"]
    },
    "Workout": {
      "title": "Sessão de Treino",
      "description": "Uma sessão de treino específica.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["in-progress", "completed"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "nomeTreino": { "type": "string" },
        "semana": { "type": "integer" },
        "diaDaSemana": { "type": "string" },
        "goalAtTime": { "type": "string" }
      },
      "required": ["userId", "status", "startTime", "nomeTreino"]
    },
    "SetRecord": {
      "title": "Registro de Série",
      "description": "Dados de uma série individual realizada.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "workoutId": { "type": "string" },
        "exerciseId": { "type": "string" },
        "exerciseNome": { "type": "string" },
        "setNumber": { "type": "integer" },
        "plannedReps": { "type": "integer" },
        "plannedWeight": { "type": "number" },
        "actualReps": { "type": "integer" },
        "actualWeight": { "type": "number" },
        "restTimeSeconds": { "type": "integer" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "failed": { "type": "boolean" },
        "origem": { "type": "string", "enum": ["Manual", "Plano"] },
        "goalAtTime": { "type": "string" },
        "muscleGroup": { "type": "string" }
      },
      "required": ["userId", "workoutId", "exerciseId", "setNumber", "actualReps", "actualWeight"]
    },
    "Plano": {
      "title": "Plano de Treino",
      "description": "Programação semanal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "semana": { "type": "integer" },
        "diaDaSemana": { "type": "string" },
        "nomeTreino": { "type": "string" },
        "exercicios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exercicioId": { "type": "string" },
              "exercicioNome": { "type": "string" },
              "seriesPlanejadas": { "type": "integer" },
              "repeticoesPlanejadas": { "type": "integer" },
              "pesoPlanejado": { "type": "number" },
              "observacoesPlano": { "type": "string" }
            }
          }
        }
      },
      "required": ["userId", "semana", "diaDaSemana", "nomeTreino", "exercicios"]
    }
  },
  "firestore": {
    "users/{userId}/profile/data": {
      "schema": "UserProfile",
      "description": "Perfil do usuário."
    },
    "exercises/{exerciseId}": {
      "schema": "Exercicio",
      "description": "Catálogo de exercícios."
    },
    "workouts/{workoutId}": {
      "schema": "Workout",
      "description": "Sessões de treino."
    },
    "workouts/{workoutId}/exercises/{exerciseId}/series/{seriesId}": {
      "schema": "SetRecord",
      "description": "Séries dentro de um exercício em um treino."
    },
    "planos/{planoId}": {
      "schema": "Plano",
      "description": "Programação de treinos."
    }
  }
}
