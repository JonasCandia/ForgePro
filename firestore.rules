rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Exercicio Validation
    function isValidExercicio(data) {
      return data.keys().hasAll(['nome', 'grupoMuscular']) &&
             data.keys().size() == 2 &&
             data.nome is string && data.nome.size() <= 100 &&
             data.grupoMuscular is string && data.grupoMuscular.size() <= 50;
    }

    // Registro Validation
    function isValidRegistro(data) {
      let requiredFields = ['userId', 'data', 'exercicioId', 'exercicioNome', 'series', 'repeticoes', 'pesoKg', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.userId == request.auth.uid &&
             data.data is string && 
             data.exercicioId is string &&
             data.exercicioNome is string && data.exercicioNome.size() <= 100 &&
             data.series is int && data.series >= 0 &&
             data.repeticoes is int && data.repeticoes >= 0 &&
             data.pesoKg is number && data.pesoKg >= 0 &&
             (data.createdAt == request.time || data.createdAt is timestamp) &&
             (!data.keys().hasAny(['observacoes']) || (data.observacoes is string && data.observacoes.size() <= 500)) &&
             (!data.keys().hasAny(['origem']) || (data.origem in ['Manual', 'Plano']));
    }

    // Plano Validation
    function isValidPlano(data) {
      let requiredFields = ['userId', 'semana', 'diaDaSemana', 'nomeTreino', 'exercicios'];
      return data.keys().hasAll(requiredFields) &&
             data.userId == request.auth.uid &&
             data.semana is int &&
             data.diaDaSemana is string &&
             data.nomeTreino is string &&
             data.exercicios is list &&
             data.exercicios.size() <= 20;
    }

    // Workout Validation
    function isValidWorkout(data) {
      return data.userId == request.auth.uid &&
             data.data is string &&
             data.status in ['em_andamento', 'finalizado'] &&
             data.exerciciosSummary is list;
    }

    function isValidSeries(data) {
      return data.userId == request.auth.uid &&
             data.exercicioId is string &&
             data.pesoReal is number && data.pesoReal >= 0 &&
             data.repeticoesReais is int && data.repeticoesReais >= 0;
    }

    // Collections

    // User profile
    match /users/{userId}/profile/{document} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global exercise catalog
    match /exercicios/{exercicioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidExercicio(request.resource.data);
      allow update: if isSignedIn() && isValidExercicio(request.resource.data);
      allow delete: if false;
    }

    // Workouts (new structure replacing registros)
    match /workouts/{workoutId} {
      allow create: if isSignedIn() && isValidId(workoutId) && isValidWorkout(request.resource.data);
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /series/{seriesId} {
        allow create: if isSignedIn() && isValidId(seriesId) && isValidSeries(request.resource.data);
        allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    // Legacy registros (read/delete only)
    match /registros/{registroId} {
      allow create: if false;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get, delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    match /planos/{planoId} {
      allow create: if isSignedIn() && isValidId(planoId) && isValidPlano(request.resource.data);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && isValidPlano(request.resource.data);
    }
  }
}
