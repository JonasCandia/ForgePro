rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Exercicio Validation
    function isValidExercicio(data) {
      return data.keys().hasAll(['nome', 'grupoMuscular']) &&
             data.keys().size() == 2 &&
             data.nome is string && data.nome.size() <= 100 &&
             data.grupoMuscular is string && data.grupoMuscular.size() <= 50;
    }

    // Collections

    // User profile
    match /users/{userId}/profile/{document} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global exercise catalog
    match /exercicios/{exercicioId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidExercicio(request.resource.data);
      allow update: if isSignedIn() && isValidExercicio(request.resource.data);
      allow delete: if false;
    }

    // All user data scoped under users/{userId}
    match /users/{userId} {
      // Profile stored directly in the user document
      allow read, write: if isOwner(userId);

      // Plans scoped to user (eliminates global planos/ collection)
      match /planos/{planoId} {
        allow read, write: if isOwner(userId);
      }

      // Workouts with series[] embedded (eliminates series/ subcollection)
      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.data is string
          && request.resource.data.status in ['em_andamento', 'finalizado'];
        allow update: if isOwner(userId)
          && resource.data.userId == userId;
      }

      // Measurements grouped by month (YYYY-MM documents with entries[] array)
      match /measurements/{monthId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
