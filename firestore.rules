rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Validation Helpers
    function isValidProfile(data) {
      let required = ['nome', 'pesoAtualKg', 'alturaCm', 'objetivo'];
      return data.keys().hasAll(required) &&
             data.nome is string && data.nome.size() > 0 &&
             data.pesoAtualKg is number && data.pesoAtualKg > 0 &&
             data.objetivo in ['cutting', 'bulking', 'manutenção'];
    }

    function isValidWorkout(data) {
      let required = ['userId', 'status', 'startTime', 'nomeTreino'];
      return data.keys().hasAll(required) &&
             data.userId == request.auth.uid &&
             data.status in ['in-progress', 'completed'] &&
             data.startTime is timestamp;
    }

    function isValidSeries(data) {
      let required = ['userId', 'workoutId', 'exerciseId', 'setNumber', 'actualReps', 'actualWeight'];
      return data.keys().hasAll(required) &&
             data.userId == request.auth.uid &&
             data.setNumber is int &&
             data.actualReps is int &&
             data.actualWeight is number;
    }

    // Collections
    
    // Global Catalog
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Allow users to contribute exercises if not in catalog
      allow update: if false; // Only admin (manual)
    }

    // User Profile
    match /users/{userId}/profile/data {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidProfile(request.resource.data);
    }

    // Plans
    match /planos/{planoId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Workouts & Series
    match /workouts/{workoutId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidWorkout(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidWorkout(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
      
      match /exercises/{exerciseId}/series/{seriesId} {
        allow read: if isOwner(resource.data.userId);
        allow create: if isOwner(request.resource.data.userId) && isValidSeries(request.resource.data);
        allow update: if isOwner(resource.data.userId) && isValidSeries(request.resource.data);
        allow delete: if isOwner(resource.data.userId);
      }
    }
    
    // Legacy support for Registros (if needed)
    match /registros/{registroId} {
       allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
       allow write: if isOwner(resource.data.userId || request.resource.data.userId);
    }
  }
}
